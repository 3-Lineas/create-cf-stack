{
  "name": "@3lineas/create-cf-stack",
  "version": "1.1.12",
  "description": "Interactive CLI to scaffold a Cloudflare + Next.js + Hono Turborepo stack",
  "author": "Diego Nelson (3 Lineas)",
  "type": "module",
  "bin": {
    "create-cf-stack": "index.mjs"
  },
  "imports": {
    "#commands/*.mjs": "./commands/*.mjs",
    "#utils/*.mjs": "./utils/*.mjs",
    "#errors/*.mjs": "./errors/*.mjs"
  },
  "files": [
    "index.mjs",
    "commands",
    "utils",
    "errors"
  ],
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\""
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "execa": "^8.0.1",
    "giget": "^1.2.1",
    "picocolors": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
